# Copy to .env.local and fill in. NEVER commit real values.
# Variables are added here as the features that need them are built (see docs/00-discovery.md).

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (PostgreSQL, EU region) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Authentication (Better Auth) ---
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Siła dotyku <rezerwacje@example.com>"

# --- Notifications for Wiktoria ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Scheduled jobs (request expiry, reminders) ---
CRON_SECRET=generate-a-long-random-string
